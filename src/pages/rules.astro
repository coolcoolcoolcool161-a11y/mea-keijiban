---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const base = '/mea-keijiban';
const faqs = [
  {
    q: '紹介コードはどこで入力しますか？',
    a: 'サービスごとに、登録画面やアプリの中にコード入力欄があります。各サービスの掲示板ページに「コードの使い方」をまとめているので、その通りに進めてみてください。紹介リンク型のサービスは、紹介リンクから申し込むだけでOKです。',
  },
  {
    q: '登録にお金はかかりますか？',
    a: 'ここで紹介しているサービスは、どれも登録無料です。特典をもらう条件（広告の利用やお支払いなど）があるサービスは、各サービスの特典欄とブログの紹介文をチェックしてみてください。',
  },
  {
    q: '特典はいつもらえますか？',
    a: 'サービスと条件によって違います。各サービスの紹介文に書かれた条件を達成するともらえます。条件や期限は変わることがあるので、登録前に紹介文を確認してください。',
  },
  {
    q: '自分の紹介コードも載せられますか？',
    a: 'もちろん載せられます。投稿フォームから、この掲示板で紹介している19サービスの中から選んで投稿してください。一覧にないサービスは「その他」を選んで、サービス名を書けば投稿できます。使いたいコードを探すのにも使えます。',
  },
  {
    q: 'すでに登録済みのサービスでもコードは使えますか？',
    a: '紹介コードは、これから新規登録する人が使うためのものです。すでに登録済みのサービスでは使えない場合があります。',
  },
  {
    q: '投稿した内容を消してほしいときは？',
    a: '投稿の編集・削除機能はありません。削除してほしい投稿の「通報する」ボタンから、理由を選んでご連絡ください。運営が確認して対応します。',
  },
  {
    q: 'URLを投稿できないのはなぜですか？',
    a: 'URLスパムやフィッシングを防ぐためです。紹介コードだけなら安全に探し合えるので、ご協力をお願いします。ただし楽天モバイルなど紹介リンク型のサービスでは、コード欄に限り紹介リンクを貼れます。',
  },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={`ルール・FAQ｜${SITE.name}`}
  description="ポイ活ひろばのルールと、よくある質問をまとめています。投稿のお約束、コードの入力方法、削除の依頼方法など。"
  canonicalPath="/rules/"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <p class="breadcrumb"><a href={`${base}/`}>{SITE.name}</a> ＞ ルール・FAQ</p>
    <h1>ルール・FAQ 📝</h1>

    <section class="panel">
      <h2>掲示板のお約束 📝</h2>
      <ul class="rule-list">
        <li>投稿できるのは、この掲示板で紹介している19サービスの紹介コードと、「その他」から投稿するそれ以外のサービスの紹介コードです。</li>
        <li>URLの投稿は禁止です（URLスパム防止のため）。紹介コードだけを載せてください。ただし楽天モバイルなど紹介リンク型のサービスは、コード欄に紹介リンクを貼れます。</li>
        <li>メールアドレス・電話番号などの個人情報は絶対に載せないでください。</li>
        <li>同じコードの連続投稿はできません（投稿から10分間は同じコードを再投稿できません）。</li>
        <li>連続投稿は1分に1件までです。</li>
        <li>他の人のコードを自分のコードのように見せかける投稿、うその特典・条件を書く投稿は禁止です。</li>
        <li>誹謗中傷や、他の利用者が不快になる内容は書かないでください。</li>
        <li>ルールに反する投稿は、運営の判断で予告なく非表示・削除することがあります。</li>
      </ul>
    </section>

    <section class="panel">
      <h2>投稿のしかた</h2>
      <ol class="rule-list">
        <li>投稿フォームでサービスを選びます。</li>
        <li>紹介コードを入力します（表示名と一言コメントは任意です）。</li>
        <li>「投稿する」を押すと、すぐに一覧へ表示されます（即時公開）。</li>
      </ol>
      <p>投稿の編集・削除機能はありません。削除してほしい投稿がある場合は、その投稿の「通報する」ボタンからご連絡ください。運営が確認して対応します。</p>
    </section>

    <section>
      <h2>よくある質問 ❓</h2>
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>Q. {f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <p class="article-meta">最終更新日：{SITE.dateModified}</p>
  </div>
</BaseLayout>
